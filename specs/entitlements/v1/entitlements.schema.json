{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privometry.dev/specs/entitlements/v1/entitlements.schema.json",
  "title": "Privometry entitlements v1",
  "description": "What an organization may use. Every deployable checks feature keys and limits, never edition names. Signed with the license key (DSSE payloadType application/vnd.privometry.entitlements+json) and carried inside policy bundles and license files. Free features never check entitlements (ADR-0003), so nothing here can switch off local protection.",
  "type": "object",
  "required": ["schema", "org_id", "edition", "features", "limits", "valid_from", "valid_until", "grace_days", "post_expiry_retention_days", "state", "issued_at", "key_id"],
  "properties": {
    "schema": { "const": "privometry.entitlements/v1" },
    "org_id": { "$ref": "../../common/v1/common.schema.json#/$defs/org_id" },
    "edition": { "enum": ["free", "trial", "team", "enterprise"], "description": "For display only." },
    "features": {
      "type": "object",
      "description": "Feature key to enabled. Keys come from feature-registry.json; consumers treat unknown or missing keys as false.",
      "propertyNames": { "$ref": "../../common/v1/common.schema.json#/$defs/snake_case" },
      "additionalProperties": { "type": "boolean" }
    },
    "limits": {
      "type": "object",
      "required": ["seats", "retention_days", "events_per_day", "devices_per_user"],
      "description": "null means unlimited.",
      "properties": {
        "seats": { "$ref": "#/$defs/limit", "description": "Active developers: enrolled users with agent activity in the last 30 days." },
        "retention_days": { "$ref": "#/$defs/limit" },
        "events_per_day": { "$ref": "#/$defs/limit" },
        "devices_per_user": { "$ref": "#/$defs/limit" }
      }
    },
    "valid_from": { "$ref": "../../common/v1/common.schema.json#/$defs/timestamp" },
    "valid_until": {
      "oneOf": [{ "$ref": "../../common/v1/common.schema.json#/$defs/timestamp" }, { "type": "null" }],
      "description": "End of the paid or trial period; null only for the free edition."
    },
    "grace_days": { "type": "integer", "minimum": 0, "maximum": 365, "default": 15 },
    "post_expiry_retention_days": { "type": "integer", "minimum": 0, "maximum": 3650, "default": 30 },
    "state": {
      "enum": ["active", "trial", "grace", "expired"],
      "description": "Computed at issue time. Consumers recompute it from valid_until, grace_days and their own clock, and use the later of the two states."
    },
    "issued_at": { "$ref": "../../common/v1/common.schema.json#/$defs/timestamp" },
    "key_id": { "$ref": "../../common/v1/common.schema.json#/$defs/keyid" },
    "ext": { "$ref": "../../common/v1/common.schema.json#/$defs/ext" }
  },
  "allOf": [
    {
      "if": { "properties": { "edition": { "const": "free" } } },
      "then": { "properties": { "valid_until": { "type": "null" }, "state": { "const": "active" } } },
      "else": { "properties": { "valid_until": { "type": "string" } } }
    },
    {
      "if": { "properties": { "state": { "const": "trial" } } },
      "then": { "properties": { "edition": { "const": "trial" } } }
    },
    {
      "properties": { "key_id": { "pattern": "^license:" } }
    }
  ],
  "$defs": {
    "limit": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
  }
}
