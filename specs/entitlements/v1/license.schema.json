{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privometry.dev/specs/entitlements/v1/license.schema.json",
  "title": "Privometry license file v1",
  "description": "Payload of a license file: a DSSE envelope with payloadType application/vnd.privometry.license+json, signed with the license key and verified offline by the MCP gateway and the self-hosted data plane.",
  "type": "object",
  "required": ["schema", "license_id", "customer_name", "deployment", "issued_at", "entitlements"],
  "properties": {
    "schema": { "const": "privometry.license/v1" },
    "license_id": { "$ref": "../../common/v1/common.schema.json#/$defs/license_id" },
    "customer_name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "deployment": { "enum": ["saas", "self_hosted", "air_gapped"] },
    "binding": {
      "type": "object",
      "description": "Optional lock to one installation; a verifier refuses the license elsewhere.",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "installation_id": { "type": "string", "minLength": 8, "maxLength": 128 },
        "cluster_id": { "type": "string", "minLength": 8, "maxLength": 128 }
      }
    },
    "issued_at": { "$ref": "../../common/v1/common.schema.json#/$defs/timestamp" },
    "entitlements": { "$ref": "entitlements.schema.json" },
    "ext": { "$ref": "../../common/v1/common.schema.json#/$defs/ext" }
  },
  "allOf": [
    {
      "if": { "properties": { "deployment": { "const": "air_gapped" } } },
      "then": { "required": ["binding"] }
    },
    {
      "properties": { "entitlements": { "properties": { "edition": { "enum": ["trial", "team", "enterprise"] } } } }
    }
  ]
}
