{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privometry.dev/specs/entitlements/v1/feature-registry.schema.json",
  "title": "Privometry feature registry v1",
  "description": "Every feature key and which editions include it, and each edition's default limits and periods (PRD LIC-01: editions and entitlements are data). New features add keys; a key is never reused for something else.",
  "type": "object",
  "required": [
    "schema",
    "features",
    "editions"
  ],
  "properties": {
    "schema": {
      "const": "privometry.feature_registry/v1"
    },
    "features": {
      "type": "object",
      "propertyNames": {
        "$ref": "../../common/v1/common.schema.json#/$defs/snake_case"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "description",
          "editions",
          "since"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "editions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "free",
                "trial",
                "team",
                "enterprise"
              ]
            }
          },
          "local": {
            "type": "boolean",
            "description": "Runs on the device without the cloud. Local features must be free and are never checked (ADR-0003)."
          },
          "since": {
            "$ref": "../../common/v1/common.schema.json#/$defs/semver",
            "description": "Spec version that added the key."
          }
        },
        "if": {
          "required": [
            "local"
          ],
          "properties": {
            "local": {
              "const": true
            }
          }
        },
        "then": {
          "properties": {
            "editions": {
              "contains": {
                "const": "free"
              }
            }
          }
        }
      }
    },
    "editions": {
      "type": "object",
      "required": [
        "free",
        "trial",
        "team",
        "enterprise"
      ],
      "additionalProperties": false,
      "properties": {
        "free": {
          "$ref": "#/$defs/edition"
        },
        "trial": {
          "$ref": "#/$defs/edition"
        },
        "team": {
          "$ref": "#/$defs/edition"
        },
        "enterprise": {
          "$ref": "#/$defs/edition"
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "edition": {
      "type": "object",
      "required": [
        "description",
        "limits",
        "grace_days",
        "seat_grace_days",
        "post_expiry_retention_days"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "limits": {
          "$ref": "entitlements.schema.json#/properties/limits",
          "description": "The edition's limits. For paid editions seats is the default; a subscription or contract sets its own."
        },
        "trial_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90,
          "description": "Trial only: how long a trial lasts."
        },
        "min_seats": {
          "type": "integer",
          "minimum": 1,
          "description": "Paid editions: the fewest seats a subscription may have."
        },
        "grace_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 365,
          "description": "After valid_until, how long everything keeps working before the organization is downgraded to free (LIC-05)."
        },
        "seat_grace_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 365,
          "description": "How long more active developers than seats are allowed before new devices are refused (LIC-05). Nothing else degrades."
        },
        "post_expiry_retention_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650,
          "description": "After a downgrade, how long cloud events are kept before they are deleted."
        }
      }
    }
  }
}
