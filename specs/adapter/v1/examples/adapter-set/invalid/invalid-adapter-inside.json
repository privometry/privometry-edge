{
  "adapters": [
    {
      "agent": "claude_code",
      "config_tiers": [
        {
          "format": "json",
          "holds": [
            "settings",
            "permissions",
            "hooks",
            "plugins"
          ],
          "paths": {
            "any": [
              "~/.claude/settings.json"
            ]
          },
          "tier": "user"
        },
        {
          "format": "json",
          "holds": [
            "settings",
            "permissions",
            "hooks",
            "plugins"
          ],
          "paths": {
            "any": [
              ".claude/settings.json",
              ".claude/settings.local.json"
            ]
          },
          "tier": "project"
        },
        {
          "format": "json",
          "holds": [
            "settings",
            "permissions",
            "hooks"
          ],
          "paths": {
            "linux": [
              "/etc/claude-code/managed-settings.json",
              "/etc/claude-code/managed-settings.d/*.json"
            ],
            "macos": [
              "/Library/Application Support/ClaudeCode/managed-settings.json",
              "/Library/Application Support/ClaudeCode/managed-settings.d/*.json"
            ],
            "windows": [
              "C:\\Program Files\\ClaudeCode\\managed-settings.json",
              "C:\\Program Files\\ClaudeCode\\managed-settings.d\\*.json"
            ]
          },
          "tier": "managed"
        },
        {
          "format": "markdown",
          "holds": [
            "skills"
          ],
          "paths": {
            "any": [
              "~/.claude/skills/*/SKILL.md"
            ]
          },
          "tier": "user"
        },
        {
          "format": "markdown",
          "holds": [
            "skills"
          ],
          "paths": {
            "any": [
              ".claude/skills/*/SKILL.md"
            ]
          },
          "tier": "project"
        }
      ],
      "detect": {
        "binaries": [
          "claude"
        ],
        "processes": [
          "claude"
        ],
        "version_cmd": [
          "claude",
          "--version"
        ]
      },
      "display_name": "Claude Code",
      "env_overrides": [
        {
          "replaces": "~/.claude",
          "var": "CLAUDE_CONFIG_DIR"
        }
      ],
      "hooks": {
        "events": [
          {
            "matcher": "*",
            "name": "PreToolUse",
            "request": {
              "cwd": "/cwd",
              "mcp_server": "/mcp_server/name",
              "permission_mode": "/permission_mode",
              "session_id": "/session_id",
              "tool_input": "/tool_input",
              "tool_name": "/tool_name",
              "tool_use_id": "/tool_use_id"
            },
            "responses": {
              "allow": {
                "exit_code": 0,
                "stdout": {
                  "hookSpecificOutput": {
                    "hookEventName": "PreToolUse",
                    "permissionDecision": "allow",
                    "permissionDecisionReason": "{message}"
                  }
                }
              },
              "ask": {
                "exit_code": 0,
                "stdout": {
                  "hookSpecificOutput": {
                    "hookEventName": "PreToolUse",
                    "permissionDecision": "ask",
                    "permissionDecisionReason": "{message}"
                  }
                }
              },
              "deny": {
                "exit_code": 0,
                "stdout": {
                  "hookSpecificOutput": {
                    "hookEventName": "PreToolUse",
                    "permissionDecision": "deny",
                    "permissionDecisionReason": "{message}"
                  }
                }
              }
            },
            "role": "pre_tool",
            "verdicts": [
              "allow",
              "ask",
              "deny"
            ]
          },
          {
            "matcher": "*",
            "name": "PostToolUse",
            "request": {
              "cwd": "/cwd",
              "mcp_server": "/mcp_server/name",
              "permission_mode": "/permission_mode",
              "session_id": "/session_id",
              "tool_input": "/tool_input",
              "tool_name": "/tool_name",
              "tool_response": "/tool_response",
              "tool_use_id": "/tool_use_id"
            },
            "responses": {
              "none": {
                "exit_code": 0,
                "stdout": null
              }
            },
            "role": "post_tool",
            "verdicts": []
          },
          {
            "name": "SessionStart",
            "request": {
              "cwd": "/cwd",
              "session_id": "/session_id"
            },
            "responses": {
              "none": {
                "exit_code": 0,
                "stdout": null
              }
            },
            "role": "session_start",
            "verdicts": []
          },
          {
            "name": "SessionEnd",
            "request": {
              "cwd": "/cwd",
              "session_id": "/session_id"
            },
            "responses": {
              "none": {
                "exit_code": 0,
                "stdout": null
              }
            },
            "role": "session_end",
            "verdicts": []
          },
          {
            "name": "ConfigChange",
            "request": {
              "config_path": "/file_path",
              "config_source": "/source",
              "cwd": "/cwd",
              "session_id": "/session_id"
            },
            "responses": {
              "none": {
                "exit_code": 0,
                "stdout": null
              }
            },
            "role": "config_change",
            "verdicts": []
          }
        ],
        "fail_closed_option": {
          "key": "onFailure",
          "min_version": "2.1.295",
          "value": "block"
        },
        "imported_by": [
          {
            "agent": "cursor",
            "default_enabled": true,
            "setting": "Third-Party Imports"
          }
        ],
        "install": {
          "enterprise": {
            "lock": {
              "key": "allowManagedHooksOnly",
              "value": true
            },
            "paths": {
              "linux": [
                "/etc/claude-code/managed-settings.d/50-privometry.json"
              ],
              "macos": [
                "/Library/Application Support/ClaudeCode/managed-settings.d/50-privometry.json"
              ],
              "windows": [
                "C:\\Program Files\\ClaudeCode\\managed-settings.d\\50-privometry.json"
              ]
            },
            "tier": "managed"
          },
          "free": {
            "paths": {
              "any": [
                "~/.claude/settings.json"
              ]
            },
            "tier": "user"
          }
        },
        "registration": "vscode_tasks",
        "timeout_seconds": 10,
        "trust": {
          "required": false
        }
      },
      "mcp_sources": [
        {
          "format": "json",
          "paths": {
            "any": [
              "~/.claude.json"
            ]
          },
          "pointer": "/mcpServers",
          "tier": "user"
        },
        {
          "format": "json",
          "paths": {
            "any": [
              ".mcp.json"
            ]
          },
          "pointer": "/mcpServers",
          "tier": "project"
        }
      ],
      "mcp_tools": {
        "name_template": "mcp__{server}__{tool}"
      },
      "posture_checks": [
        "auto_approve_mode",
        "sandbox_disabled",
        "managed_hooks_only_off",
        "unapproved_mcp_server",
        "secret_in_config"
      ],
      "schema": "privometry.adapter/v1",
      "tool_kinds": {
        "*": "other",
        "Agent": "subagent_spawn",
        "Bash": "shell_exec",
        "Edit": "file_write",
        "Glob": "file_read",
        "Grep": "file_read",
        "NotebookEdit": "file_write",
        "PowerShell": "shell_exec",
        "Read": "file_read",
        "Task": "subagent_spawn",
        "WebFetch": "network_fetch",
        "WebSearch": "web_search",
        "Write": "file_write",
        "mcp__*": "mcp_call"
      },
      "tool_targets": {
        "Bash": {
          "command": "/command"
        },
        "Edit": {
          "path": "/file_path"
        },
        "Glob": {
          "path": "/path"
        },
        "Grep": {
          "path": "/path"
        },
        "NotebookEdit": {
          "path": "/notebook_path"
        },
        "PowerShell": {
          "command": "/command"
        },
        "Read": {
          "path": "/file_path"
        },
        "WebFetch": {
          "url": "/url"
        },
        "WebSearch": {
          "query": "/query"
        },
        "Write": {
          "path": "/file_path"
        }
      },
      "verified": [
        {
          "fixtures": "claude_code/2.1.304",
          "version": "2.1.304"
        }
      ],
      "versions": ">=2.1.295 <3.0.0"
    },
    {
      "agent": "codex_cli",
      "config_tiers": [
        {
          "format": "toml",
