{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privometry.dev/specs/rulepack/v1/rules.schema.json",
  "title": "Privometry rule pack rules file v1",
  "description": "A file in a pack's rules/ folder: a list of rules in the policy language. Pack rules cannot be locked or overridable (organization-only settings); rule IDs must be unique across the whole pack, which the pack test runner checks.",
  "type": "object",
  "required": ["schema", "rules"],
  "properties": {
    "schema": { "const": "privometry.rules/v1" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "../../policy/v1/policy.schema.json#/$defs/rule" },
          {
            "not": {
              "anyOf": [
                { "required": ["locked"] },
                { "required": ["overridable"] }
              ]
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
