{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privometry.dev/specs/edge-api/v1/messages.schema.json",
  "title": "Privometry edge API v1 messages",
  "description": "Request and response bodies of /edge/v1, referenced from openapi.yaml. Kept as plain JSON Schema so both repos validate them with the same tooling as the other contracts.",
  "$defs": {
    "pem_csr": { "type": "string", "pattern": "^-----BEGIN CERTIFICATE REQUEST-----\\n[A-Za-z0-9+/=\\n]+-----END CERTIFICATE REQUEST-----\\n?$" },
    "pem_chain": { "type": "string", "pattern": "^(-----BEGIN CERTIFICATE-----\\n[A-Za-z0-9+/=\\n]+-----END CERTIFICATE-----\\n?)+$" },
    "command_id": { "type": "string", "pattern": "^cmd_[0-9A-HJKMNP-TV-Z]{26}$" },

    "EnrollRequest": {
      "type": "object",
      "required": ["enrollment_token", "csr", "device"],
      "properties": {
        "enrollment_token": { "type": "string", "minLength": 20, "maxLength": 512, "description": "One-time token from the console or MDM, or from account-api/v1 when privometry login registers a person (POST /registrations/{registration_id}:complete); that token is bound to the person and valid 10 minutes." },
        "csr": { "$ref": "#/$defs/pem_csr", "description": "PKCS#10 request for an Ed25519 or P-256 key generated on the device; the private key never leaves it." },
        "device": {
          "type": "object",
          "required": ["os", "os_version", "arch", "sensor_version"],
          "properties": {
            "os": { "$ref": "../../common/v1/common.schema.json#/$defs/os" },
            "os_version": { "type": "string", "maxLength": 64 },
            "arch": { "$ref": "../../common/v1/common.schema.json#/$defs/arch" },
            "sensor_version": { "$ref": "../../common/v1/common.schema.json#/$defs/semver" },
            "local_device_id": { "type": "string", "maxLength": 64, "description": "The Free-tier local ID, so buffered events can be re-keyed. Never uploaded before enrollment." }
          }
        }
      }
    },
    "EnrollResponse": {
      "type": "object",
      "required": ["device_id", "org_id", "region", "api_base_url", "certificate", "certificate_expires_at", "hash_key"],
      "properties": {
        "device_id": { "$ref": "../../common/v1/common.schema.json#/$defs/device_id" },
        "org_id": { "$ref": "../../common/v1/common.schema.json#/$defs/org_id" },
        "user_id": { "$ref": "../../common/v1/common.schema.json#/$defs/user_id", "description": "Set when the token is bound to a person, as tokens from account registration always are." },
        "region": { "type": "string", "pattern": "^[a-z]{2,8}$" },
        "api_base_url": { "$ref": "../../common/v1/common.schema.json#/$defs/https_url" },
        "certificate": { "$ref": "#/$defs/pem_chain" },
        "certificate_expires_at": { "$ref": "../../common/v1/common.schema.json#/$defs/timestamp" },
        "hash_key": {
          "type": "object",
          "required": ["id", "key"],
          "description": "Organization key for hashed fields: HMAC-SHA256(key, normalized value). Stored with the device key and never uploaded.",
          "properties": {
            "id": { "type": "string", "pattern": "^hk_[0-9A-HJKMNP-TV-Z]{26}$" },
            "key": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$", "description": "32 random bytes, base64." }
          }
        },
        "key_set": {
          "allOf": [
            { "$ref": "../../common/v1/dsse.schema.json" },
            { "properties": { "payloadType": { "const": "application/vnd.privometry.keyset+json" } } }
          ],
          "description": "The region's key set (common/v1 keyset.schema.json) signed by a root key: the policy and license keys the device verifies bundles and entitlements with. A sensor with root keys built in verifies it against them; one without pins it at enrollment, after checking it is signed by a root key it lists."
        }
      }
    },
    "RenewRequest": {
      "type": "object",
      "required": ["csr"],
      "properties": { "csr": { "$ref": "#/$defs/pem_csr" } }
    },
    "RenewResponse": {
      "type": "object",
      "required": ["certificate", "certificate_expires_at"],
      "properties": {
        "certificate": { "$ref": "#/$defs/pem_chain" },
        "certificate_expires_at": { "$ref": "../../common/v1/common.schema.json#/$defs/timestamp" }
      }
    },
    "EventsBatch": {
      "type": "object",
      "required": ["events"],
      "description": "Up to 500 events or 1 MB gzip. Idempotent on event_id.",
      "properties": {
        "events": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "../../event-schema/v1/event.schema.json" } }
      }
    },
    "EventsBatchResult": {
      "type": "object",
      "required": ["accepted", "duplicates", "rejected"],
      "properties": {
        "accepted": { "type": "integer", "minimum": 0 },
        "duplicates": { "type": "integer", "minimum": 0, "description": "Already stored; the edge treats them as delivered." },
        "rejected": {
          "type": "array",
          "description": "Events the edge must not retry, for example a schema violation or an unredacted secret.",
          "items": {
            "type": "object",
            "required": ["event_id", "type"],
            "properties": {
              "event_id": { "$ref": "../../common/v1/common.schema.json#/$defs/event_id" },
              "type": { "type": "string", "format": "uri", "description": "Problem type URI, as in RFC 9457." },
              "detail": { "type": "string", "maxLength": 1024 }
            }
          }
        }
      }
    },
    "InventorySnapshot": {
      "type": "object",
      "required": ["schema", "scanned_at", "device_seq", "items"],
      "description": "A full scan; the cloud replaces the device's previous inventory with it.",
      "properties": {
        "schema": { "const": "privometry.inventory_snapshot/v1" },
        "scanned_at": { "$ref": "../../common/v1/common.schema.json#/$defs/timestamp" },
        "device_seq": { "type": "integer", "minimum": 1, "description": "The device's latest device_seq when the scan finished." },
        "items": { "type": "array", "items": { "$ref": "../../event-schema/v1/event.schema.json#/$defs/inventory/properties/item" } }
      }
    },
    "InventoryReceipt": {
      "type": "object",
      "required": ["snapshot_id", "received_at"],
      "properties": {
        "snapshot_id": { "type": "string", "pattern": "^inv_[0-9A-HJKMNP-TV-Z]{26}$" },
        "received_at": { "$ref": "../../common/v1/common.schema.json#/$defs/timestamp" }
      }
    },
    "Heartbeat": {
      "type": "object",
      "required": ["sent_at", "sensor_version", "device_seq", "adapter_set_version", "upload_queue", "hooks"],
      "properties": {
        "sent_at": { "$ref": "../../common/v1/common.schema.json#/$defs/timestamp" },
        "sensor_version": { "$ref": "../../common/v1/common.schema.json#/$defs/semver" },
        "device_seq": { "type": "integer", "minimum": 0 },
        "bundle_id": { "$ref": "../../common/v1/common.schema.json#/$defs/bundle_id" },
        "bundle_version": { "type": "integer", "minimum": 1 },
        "adapter_set_version": { "type": "integer", "minimum": 0 },
        "riskfeed_sequence": { "type": "integer", "minimum": 0 },
        "keyset_version": { "type": "integer", "minimum": 1 },
        "upload_queue": {
          "type": "object",
          "required": ["events", "bytes"],
          "properties": {
            "events": { "type": "integer", "minimum": 0 },
            "bytes": { "type": "integer", "minimum": 0 },
            "oldest_at": { "$ref": "../../common/v1/common.schema.json#/$defs/timestamp" }
          }
        },
        "hooks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["agent_product", "tier", "status"],
            "properties": {
              "agent_product": { "$ref": "../../common/v1/common.schema.json#/$defs/agent_product" },
              "agent_version": { "type": "string", "maxLength": 64 },
              "tier": { "$ref": "../../common/v1/common.schema.json#/$defs/config_tier" },
              "status": { "enum": ["installed", "missing", "modified", "untrusted", "disabled", "unsupported"], "description": "untrusted: installed but the agent has not approved it yet (Codex hook trust). disabled: installed, but a setting turns the agent's hooks off or Privometry's own entry is turned off (adapter hooks.disable_settings)." }
            }
          }
        },
        "active_stops": { "type": "array", "items": { "$ref": "#/$defs/command_id" }, "description": "Kill-switch commands currently in force." },
        "acked_commands": { "type": "array", "items": { "$ref": "#/$defs/command_id" }, "description": "Commands applied since the last heartbeat." }
      }
    },
    "HeartbeatResponse": {
      "type": "object",
      "required": ["next_heartbeat_seconds", "commands"],
      "properties": {
        "next_heartbeat_seconds": { "type": "integer", "minimum": 10, "maximum": 3600 },
        "commands": { "type": "array", "items": { "$ref": "#/$defs/Command" } }
      }
    },
    "Command": {
      "type": "object",
      "required": ["command_id", "type", "issued_at"],
      "description": "Repeated in every heartbeat response until acknowledged.",
      "properties": {
        "command_id": { "$ref": "#/$defs/command_id" },
        "type": { "enum": ["stop_session", "stop_agent", "stop_all", "release", "refresh_bundle", "rescan", "collect_diagnostics"] },
        "issued_at": { "$ref": "../../common/v1/common.schema.json#/$defs/timestamp" },
        "session_id": { "$ref": "../../common/v1/common.schema.json#/$defs/session_id" },
        "agent_product": { "$ref": "../../common/v1/common.schema.json#/$defs/agent_product" },
        "releases": { "$ref": "#/$defs/command_id", "description": "For release: the stop command being lifted." },
        "reason": { "type": "string", "maxLength": 512 }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "stop_session" } } }, "then": { "required": ["session_id"] } },
        { "if": { "properties": { "type": { "const": "stop_agent" } } }, "then": { "required": ["agent_product"] } },
        { "if": { "properties": { "type": { "const": "release" } } }, "then": { "required": ["releases"] } }
      ]
    },
    "ApprovalCreate": {
      "type": "object",
      "required": ["event_id", "session_id", "agent_product", "action", "message", "timeout_seconds"],
      "properties": {
        "event_id": { "$ref": "../../common/v1/common.schema.json#/$defs/event_id" },
        "session_id": { "$ref": "../../common/v1/common.schema.json#/$defs/session_id" },
        "agent_product": { "$ref": "../../common/v1/common.schema.json#/$defs/agent_product" },
        "repo_remote": { "type": "string", "maxLength": 512 },
        "action": {
          "type": "object",
          "required": ["kind", "target", "rule_ids"],
          "properties": {
            "kind": { "$ref": "../../common/v1/common.schema.json#/$defs/action_kind" },
            "tool_name": { "type": "string", "maxLength": 256 },
            "target": { "type": "string", "maxLength": 4096, "description": "Always redacted, whatever the organization's capture setting." },
            "rule_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "risk": { "$ref": "../../common/v1/common.schema.json#/$defs/risk" }
          }
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 280 },
        "timeout_seconds": { "type": "integer", "minimum": 10, "maximum": 300, "description": "After this the approval times out and the edge denies." }
      }
    },
    "Approval": {
      "type": "object",
      "required": ["approval_id", "status", "created_at", "expires_at"],
      "properties": {
        "approval_id": { "$ref": "../../common/v1/common.schema.json#/$defs/approval_id" },
        "status": { "enum": ["pending", "approved", "denied", "timeout"] },
        "created_at": { "$ref": "../../common/v1/common.schema.json#/$defs/timestamp" },
        "expires_at": { "$ref": "../../common/v1/common.schema.json#/$defs/timestamp" },
        "decided_at": { "$ref": "../../common/v1/common.schema.json#/$defs/timestamp" },
        "responder": {
          "type": "object",
          "required": ["channel"],
          "properties": {
            "user_id": { "$ref": "../../common/v1/common.schema.json#/$defs/user_id" },
            "display_name": { "type": "string", "maxLength": 256 },
            "channel": { "enum": ["slack", "teams", "console"] }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["approved", "denied"] } } },
          "then": { "required": ["decided_at", "responder"] }
        },
        {
          "if": { "properties": { "status": { "const": "pending" } } },
          "then": { "properties": { "decided_at": false, "responder": false } }
        }
      ]
    },
    "Problem": {
      "type": "object",
      "required": ["type", "title", "status"],
      "description": "RFC 9457 problem details. type is a stable URI per error.",
      "properties": {
        "type": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "detail": { "type": "string" },
        "instance": { "type": "string" },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["detail"],
            "properties": { "pointer": { "type": "string" }, "detail": { "type": "string" } }
          }
        }
      }
    }
  }
}
